# Neon/PostgreSQL connection used by the application
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Development-only tenant fallback. Production API routes must use the authenticated session.
FINANCE_AI_ORGANIZATION_ID="your-organization-id"

# Optional seed configuration for creating a new environment.
# FINANCE_AI_SEED_ORGANIZATION_ID="your-organization-id"
# FINANCE_AI_SEED_ORGANIZATION_NAME="Your Organization"
# FINANCE_AI_SEED_BASE_CURRENCY="NGN"
# FINANCE_AI_SEED_BRANCH_NAME="Main"
# FINANCE_AI_SEED_BRANCH_CODE="MAIN"
# FINANCE_AI_SEED_CATEGORIES_JSON='[{"name":"Your Category","classification":"INCOME"}]'

# Auth.js secret. Generate a long random value for every deployed environment.
AUTH_SECRET="replace-with-a-long-random-secret"

# AI provider credentials will be added later when the real model layer is integrated.
# Never commit provider keys to Git.
# AI_API_KEY=""
