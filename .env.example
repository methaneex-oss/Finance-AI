# Neon/PostgreSQL pooled connection used by the application
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Organization selected for the current development tenant.
# Production will derive this from the authenticated user's organization instead.
FINANCE_AI_ORGANIZATION_ID="demo-org"

# Reserved for the authentication layer; never commit real secrets.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# AI provider credentials will be added later when the real model layer is integrated.
# Never commit provider keys to Git.
# AI_API_KEY=""
